rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return profile().role; }
    function approved() {
      return signedIn()
        && (role() == 'admin' || !('approved' in profile()) || profile().approved == true);
    }
    function admin() { return signedIn() && role() == 'admin'; }
    function cashier() { return approved() && role() == 'cashier'; }
    function ownsNew() { return signedIn() && request.resource.data.owner_id == request.auth.uid; }
    function customerExists() {
      return exists(/databases/$(database)/documents/customers/$(request.resource.data.customer_id));
    }
    function validCashierStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let completing = resource.data.status == 'in_progress'
        && request.resource.data.status == 'completed'
        && changed.hasOnly(['status', 'completed_at', 'updated_at']);
      let paying = resource.data.status == 'completed'
        && request.resource.data.status == 'paid'
        && changed.hasOnly([
          'status',
          'completed_at',
          'updated_at',
          'subtotal_amount',
          'discount_type',
          'discount_value',
          'discount_amount',
          'discount_notes',
          'total_amount'
        ])
        && request.resource.data.discount_type in ['none', 'percent', 'fixed']
        && request.resource.data.subtotal_amount >= 0
        && request.resource.data.discount_value >= 0
        && request.resource.data.discount_amount >= 0
        && request.resource.data.discount_amount <= request.resource.data.subtotal_amount
        && request.resource.data.total_amount
          == request.resource.data.subtotal_amount - request.resource.data.discount_amount
        && (request.resource.data.discount_type != 'percent'
          || request.resource.data.discount_value <= 100);
      return cashier() && (completing || paying);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.role == 'cashier'
        && request.resource.data.approved == false;
      allow read: if signedIn() && (userId == request.auth.uid || admin());
      allow update, delete: if admin();
    }
    match /customers/{id} {
      allow read: if approved();
      allow create: if admin() || (cashier() && ownsNew());
      allow update, delete: if admin();
    }
    match /services/{id} {
      allow read: if approved();
      allow write: if admin();
    }
    match /transactions/{id} {
      allow read: if approved();
      allow create: if admin() || (cashier() && ownsNew() && customerExists());
      allow update: if admin() || validCashierStatusUpdate();
      allow delete: if admin();
    }
  }
}
